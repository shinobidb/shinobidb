{
  "name": "shinobidb",
  "version": "1.0.0",
  "description": "CLI tool for masking production database data for staging environments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "shinobidb": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "database",
    "masking",
    "pii",
    "anonymization",
    "staging",
    "mysql",
    "postgresql",
    "mongodb",
    "cli",
    "data-protection",
    "gdpr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shinobidb/shinobidb.git"
  },
  "homepage": "https://github.com/shinobidb/shinobidb#readme",
  "bugs": {
    "url": "https://github.com/shinobidb/shinobidb/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:dogfood": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.dogfood.config.js --runInBand",
    "benchmark": "node scripts/benchmark.mjs",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-security": "^4.0.0",
    "execa": "^9.6.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "mongodb": "^6.21.0",
    "mysql2": "^3.20.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "yaml": "^2.8.3"
  }
}
